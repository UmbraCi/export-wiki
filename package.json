{
  "name": "export-wiki",
  "version": "1.0.0",
  "type": "module",
  "description": "Tauri app for exporting Confluence Wiki content",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "tauri dev --features dev-connector",
    "dev": "npm run start",
    "dev:frontend": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test:sidecar": "cd sidecar && uv run pytest",
    "build:sidecar": "cd sidecar && uv run python -m PyInstaller --onefile --name cme-sidecar --specpath ../.build/sidecar --distpath ../.build/sidecar/dist --workpath ../.build/sidecar/work confluence_export_sidecar/__main__.py",
    "prepare:sidecar": "npm run build:sidecar && node scripts/prepare-sidecar.mjs",
    "build:mvp": "npm run prepare:sidecar && npm run build",
    "icon": "python3 scripts/fix-macos-icon-source.py && tauri icon src-tauri/icons/icon-source.png && node scripts/prune-tauri-icons.mjs",
    "typecheck": "tsc --noEmit",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^9.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@zumer/snapdom": "^1.9.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.2.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  }
}
