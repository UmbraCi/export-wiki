{
  "$schema": "https://v2.tauri.app/schemas/2.0.0/capabilities.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "confluence-sso"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/cme-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}